{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@parachute/frame": [
        "./src/frame/lib.ts"
      ],
      "@openparachute/surface-render": [
        "./packages/surface-render/src/index.ts"
      ],
      "@openparachute/surface-render/*": [
        "./packages/surface-render/src/*/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/surface-render/src",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}

+/// Longest video the relay stores: 60 minutes.
+pub const MAX_VIDEO_DURATION_SECS: f64 = 3_600.0;
+
+/// Longest audio the relay stores: 3 hours. Applies to Opus voice in Ogg or
+/// WebM, and to MP4 whose only picture is one still frame over an AAC track
+/// (sound with a cover image, which is how clients send M4A as MP4).
+pub const MAX_AUDIO_DURATION_SECS: f64 = 10_800.0;
+
+/// What a timed upload is, for its duration limit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MediaKind {
+    /// Sound only, or sound under a single still frame.
+    Audio,
+    /// Moving pictures.
+    Video,
+}
+
+impl MediaKind {
+    /// The longest upload of this kind the relay accepts, in seconds.
+    pub fn max_duration_secs(self) -> f64 {
+        match self {
+            Self::Audio => MAX_AUDIO_DURATION_SECS,
+            Self::Video => MAX_VIDEO_DURATION_SECS,
+        }
+    }
+
+    /// Refuse `secs` when it runs past this kind's limit.
+    pub(crate) fn check_duration(self, secs: f64) -> Result<(), MediaError> {
+        let max = self.max_duration_secs();
+        if secs > max {
+            return Err(MediaError::DurationTooLong {
+                kind: self,
+                max_secs: max as u64,
+            });
+        }
+        Ok(())
+    }
+}
+
+impl std::fmt::Display for MediaKind {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Audio => "audio",
+            Self::Video => "video",
+        })
+    }
+}

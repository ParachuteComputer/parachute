+/// A track's length in seconds, from its mdhd duration and timescale, in
+/// whole milliseconds rounded down (what the mp4 crate's `duration()` gives,
+/// without its u64 overflow on a huge version-1 duration).
+fn track_secs(track: &mp4::Mp4Track) -> Result<f64, MediaError> {
+    let mdhd = &track.trak.mdia.mdhd;
+    if mdhd.timescale == 0 {
+        return Err(MediaError::InvalidVideo);
+    }
+    let millis = u128::from(mdhd.duration) * 1000 / u128::from(mdhd.timescale);
+    Ok(millis as f64 / 1000.0)
+}

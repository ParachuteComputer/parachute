+//! Bounded, fail-closed inspection of the two supported voice containers.
+//! Unknown elements are rejected: bytes stored verbatim must not provide an
+//! uninspected metadata channel (including nested tags and extra tracks).
+//! Each validator returns the stream's length in seconds, for the caller's
+//! duration limit.
+
+use crate::error::MediaError;
+
+fn invalid() -> MediaError {
+    MediaError::DisallowedContentType("invalid audio container".into())
+}
+
+fn le32(b: &[u8]) -> Result<usize, MediaError> {
+    Ok(u32::from_le_bytes(
+        b.get(..4)
+            .ok_or_else(invalid)?
+            .try_into()
+            .map_err(|_| invalid())?,
+    ) as usize)
+}
+
+fn opus_head(b: &[u8]) -> bool {
+    b.len() == 19 && b.starts_with(b"OpusHead\x01") && (1..=2).contains(&b[9]) && b[18] == 0
+}
+
+fn encoder(b: &[u8]) -> bool {
+    let Ok(s) = std::str::from_utf8(b) else {
+        return false;
+    };
+    let version = |v: &str| {
+        !v.is_empty() && v.len() <= 24 && v.bytes().all(|c| c.is_ascii_digit() || c == b'.')
+    };
+    s == "Lavf"
+        || s == "Lavc libopus"
+        || s == "libopus"
+        || s == "Chrome"
+        || s == "WebKit"
+        || s.strip_prefix("Lavf").is_some_and(version)
+        || s.strip_prefix("Lavc")
+            .and_then(|v| v.strip_suffix(" libopus"))
+            .is_some_and(version)
+}
+
+fn opus_tags(b: &[u8]) -> Result<(), MediaError> {
+    if !b.starts_with(b"OpusTags") || b.len() > 4096 {
+        return Err(invalid());
+    }
+    let mut p = 8;
+    let vendor_len = le32(b.get(p..).ok_or_else(invalid)?)?;
+    p += 4;
+    let vendor = b
+        .get(p..p.checked_add(vendor_len).ok_or_else(invalid)?)
+        .ok_or_else(invalid)?;
+    if !encoder(vendor) {
+        return Err(MediaError::MetadataForbidden);
+    }
+    p += vendor_len;
+    let count = le32(b.get(p..).ok_or_else(invalid)?)?;
+    p += 4;
+    if count > 1 {
+        return Err(MediaError::MetadataForbidden);
+    }
+    for _ in 0..count {
+        let len = le32(b.get(p..).ok_or_else(invalid)?)?;
+        p += 4;
+        let value = b
+            .get(p..p.checked_add(len).ok_or_else(invalid)?)
+            .ok_or_else(invalid)?;
+        if !value.starts_with(b"encoder=") || !encoder(&value[8..]) {
+            return Err(MediaError::MetadataForbidden);
+        }
+        p += len;
+    }
+    // OpusTags permits a trailing binary region; forbid it here.
+    if p != b.len() {
+        return Err(MediaError::MetadataForbidden);
+    }
+    Ok(())
+}
+
+pub(crate) fn ogg_crc(b: &[u8]) -> u32 {
+    let mut crc = 0u32;
+    for (i, byte) in b.iter().enumerate() {
+        let value = if (22..26).contains(&i) { 0 } else { *byte };
+        crc ^= u32::from(value) << 24;
+        for _ in 0..8 {
+            crc = (crc << 1)
+                ^ if crc & 0x8000_0000 != 0 {
+                    0x04c1_1db7
+                } else {
+                    0
+                };
+        }
+    }
+    crc
+}
+
+/// Opus granule positions count 48 kHz samples, whatever the input rate.
+const OPUS_GRANULE_RATE: f64 = 48_000.0;
+
+pub(super) fn validate_ogg(b: &[u8]) -> Result<f64, MediaError> {
+    let mut pos = 0;
+    let mut pre_skip = 0u64;
+    let mut end_granule = 0u64;
+    let mut serial = None;
+    let mut page_no = 0u32;
+    let mut packet_no = 0;
+    let mut packet = Vec::new();
+    let mut audio_packet_bytes = 0usize;
+    let mut continued = false;
+    let mut eos = false;
+    while pos < b.len() {
+        let page = b.get(pos..).ok_or_else(invalid)?;
+        if page.len() < 27 || &page[..4] != b"OggS" || page[4] != 0 || page[5] & !0x07 != 0 || eos {
+            return Err(invalid());
+        }
+        let flags = page[5];
+        if (flags & 1 != 0) != continued || (flags & 2 != 0) != (page_no == 0) {
+            return Err(invalid());
+        }
+        let s = u32::from_le_bytes(page[14..18].try_into().map_err(|_| invalid())?);
+        if serial.is_some_and(|prev| prev != s)
+            || u32::from_le_bytes(page[18..22].try_into().map_err(|_| invalid())?) != page_no
+        {
+            return Err(invalid());
+        }
+        serial = Some(s);
+        // The end position of the last packet finished on this page; all
+        // ones means none finishes here. Take the furthest, so a page that
+        // claims to run backwards cannot hide the stream's length.
+        let granule = u64::from_le_bytes(page[6..14].try_into().map_err(|_| invalid())?);
+        if granule != u64::MAX {
+            end_granule = end_granule.max(granule);
+        }
+        let n = page[26] as usize;
+        let segments = page.get(27..27 + n).ok_or_else(invalid)?;
+        let body_len: usize = segments.iter().map(|v| *v as usize).sum();
+        let end = 27 + n + body_len;
+        let full = page.get(..end).ok_or_else(invalid)?;
+        if ogg_crc(full) != u32::from_le_bytes(page[22..26].try_into().map_err(|_| invalid())?) {
+            return Err(invalid());
+        }
+        let mut cursor = 27 + n;
+        for &len in segments {
+            let size = len as usize;
+            if packet_no < 2 {
+                if packet.len() + size > 4096 {
+                    return Err(invalid());
+                }
+                packet.extend_from_slice(&page[cursor..cursor + size]);
+            } else {
+                audio_packet_bytes += size;
+            }
+            cursor += size;
+            if len < 255 {
+                if packet_no == 0 {
+                    if !opus_head(&packet) {
+                        return Err(invalid());
+                    }
+                    pre_skip = u64::from(u16::from_le_bytes([packet[10], packet[11]]));
+                } else if packet_no == 1 {
+                    opus_tags(&packet)?;
+                } else if audio_packet_bytes == 0 {
+                    return Err(invalid());
+                }
+                packet.clear();
+                audio_packet_bytes = 0;
+                packet_no += 1;
+            }
+        }
+        continued = segments.last() == Some(&255);
+        eos = flags & 4 != 0;
+        if eos && continued {
+            return Err(invalid());
+        }
+        pos += end;
+        page_no = page_no.checked_add(1).ok_or_else(invalid)?;
+    }
+    if !eos || packet_no < 3 {
+        return Err(invalid());
+    }
+    Ok(end_granule.saturating_sub(pre_skip) as f64 / OPUS_GRANULE_RATE)
+}
+
+struct Element<'a> {
+    id: u32,
+    data: &'a [u8],
+    unknown: bool,
+}
+
+fn vint(b: &[u8], max: usize, clear: bool) -> Result<(u64, usize), MediaError> {
+    let first = *b.first().ok_or_else(invalid)?;
+    let n = (first.leading_zeros() as usize) + 1;
+    if n > max || n > b.len() {
+        return Err(invalid());
+    }
+    let mut v = u64::from(if clear {
+        first & (0xffu16 >> n) as u8
+    } else {
+        first
+    });
+    for &byte in &b[1..n] {
+        v = (v << 8) | u64::from(byte);
+    }
+    Ok((v, n))
+}
+
+fn next<'a>(b: &'a [u8], pos: &mut usize) -> Result<Element<'a>, MediaError> {
+    let (id, id_len) = vint(b.get(*pos..).ok_or_else(invalid)?, 4, false)?;
+    let (size, n) = vint(b.get(*pos + id_len..).ok_or_else(invalid)?, 8, true)?;
+    let start = pos.checked_add(id_len + n).ok_or_else(invalid)?;
+    let unknown = size == ((1u64 << (7 * n)) - 1);
+    let end = if unknown {
+        b.len()
+    } else {
+        start
+            .checked_add(usize::try_from(size).map_err(|_| invalid())?)
+            .ok_or_else(invalid)?
+    };
+    let data = b.get(start..end).ok_or_else(invalid)?;
+    *pos = end;
+    Ok(Element {
+        id: id as u32,
+        data,
+        unknown,
+    })
+}
+
+fn children<'a>(
+    b: &'a [u8],
+    mut f: impl FnMut(Element<'a>) -> Result<(), MediaError>,
+) -> Result<(), MediaError> {
+    let mut pos = 0;
+    while pos < b.len() {
+        let el = next(b, &mut pos)?;
+        if el.unknown {
+            return Err(invalid());
+        }
+        f(el)?;
+    }
+    Ok(())
+}
+
+fn number(b: &[u8]) -> Result<u64, MediaError> {
+    if b.is_empty() || b.len() > 8 {
+        return Err(invalid());
+    }
+    Ok(b.iter()
+        .fold(0u64, |acc, byte| (acc << 8) | u64::from(*byte)))
+}
+
+/// Check a (Simple)Block and return its timecode relative to its Cluster.
+fn block(b: &[u8]) -> Result<i16, MediaError> {
+    let (track, n) = vint(b, 8, true)?;
+    if track != 1 || b.len() <= n + 3 || b[n + 2] & 0x06 != 0 {
+        return Err(invalid());
+    }
+    Ok(i16::from_be_bytes([b[n], b[n + 1]]))
+}
+
+/// The latest block start in a Cluster, in Segment timecode units.
+#[derive(Default)]
+struct ClusterScan {
+    blocks: usize,
+    consumed: usize,
+    end: f64,
+}
+
+fn duration_tag(v: &[u8]) -> bool {
+    let value = v.strip_suffix(b"\0").unwrap_or(v);
+    value.len() == 18
+        && value[2] == b':'
+        && value[5] == b':'
+        && value[8] == b'.'
+        && value
+            .iter()
+            .enumerate()
+            .all(|(i, c)| matches!(i, 2 | 5 | 8) || c.is_ascii_digit())
+}
+
+fn tag(b: &[u8]) -> Result<(), MediaError> {
+    let mut name = None;
+    let mut value = None;
+    children(b, |el| match el.id {
+        0x45a3 if name.replace(el.data).is_none() => Ok(()),
+        0x4487 if value.replace(el.data).is_none() => Ok(()),
+        _ => Err(MediaError::MetadataForbidden),
+    })?;
+    match (name, value) {
+        (Some(b"ENCODER"), Some(v)) if encoder(v) => Ok(()),
+        (Some(b"DURATION"), Some(v)) if duration_tag(v) => Ok(()),
+        _ => Err(MediaError::MetadataForbidden),
+    }
+}
+
+fn tags(b: &[u8]) -> Result<(), MediaError> {
+    children(b, |el| {
+        if el.id != 0x7373 {
+            return Err(MediaError::MetadataForbidden);
+        }
+        children(el.data, |child| match child.id {
+            0x63c0 => children(child.data, |target| {
+                if target.id == 0x63c5 && number(target.data)? == 1 {
+                    Ok(())
+                } else {
+                    Err(MediaError::MetadataForbidden)
+                }
+            }),
+            0x67c8 => tag(child.data),
+            _ => Err(MediaError::MetadataForbidden),
+        })
+    })
+}
+
+fn tracks(b: &[u8]) -> Result<(), MediaError> {
+    let mut entries = 0;
+    children(b, |el| {
+        if el.id != 0xae {
+            return Err(invalid());
+        }
+        entries += 1;
+        let mut track = None;
+        let mut kind = None;
+        let mut codec = None;
+        let mut head = None;
+        children(el.data, |field| match field.id {
+            0xd7 if track.replace(number(field.data)?).is_none() => Ok(()),
+            0x83 if kind.replace(number(field.data)?).is_none() => Ok(()),
+            0x86 if codec.replace(field.data).is_none() => Ok(()),
+            0x63a2 if head.replace(field.data).is_none() => Ok(()),
+            0xe1 => children(field.data, |audio| match audio.id {
+                0xb5 | 0x9f | 0x6264 => {
+                    number(audio.data)?;
+                    Ok(())
+                }
+                _ => Err(invalid()),
+            }),
+            0x73c5 | 0x9c | 0x88 | 0x56aa | 0x56bb | 0x23e383 | 0x55ee => {
+                number(field.data)?;
+                Ok(())
+            }
+            0x22b59c if field.data == b"und" => Ok(()),
+            _ => Err(MediaError::MetadataForbidden),
+        })?;
+        if track != Some(1)
+            || kind != Some(2)
+            || codec != Some(b"A_OPUS".as_slice())
+            || !head.is_some_and(opus_head)
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    })?;
+    if entries != 1 {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+fn cluster(b: &[u8], unknown: bool) -> Result<ClusterScan, MediaError> {
+    let mut pos = 0;
+    let mut blocks = 0;
+    let mut timecode = 0u64;
+    let mut latest: Option<i16> = None;
+    let mut seen = |rel: i16| latest = Some(latest.map_or(rel, |l| l.max(rel)));
+    while pos < b.len() {
+        if unknown
+            && matches!(
+                vint(&b[pos..], 4, false)?.0 as u32,
+                0x1f43b675 | 0x1c53bb6b | 0x1254c367
+            )
+        {
+            break;
+        }
+        let el = next(b, &mut pos)?;
+        if el.unknown {
+            return Err(invalid());
+        }
+        match el.id {
+            0xe7 => {
+                timecode = number(el.data)?;
+                Ok(())
+            }
+            0xa3 => {
+                seen(block(el.data)?);
+                blocks += 1;
+                Ok(())
+            }
+            0xa0 => children(el.data, |field| match field.id {
+                0xa1 => {
+                    seen(block(field.data)?);
+                    blocks += 1;
+                    Ok(())
+                }
+                0x9b | 0xfb | 0x75a2 => {
+                    number(field.data)?;
+                    Ok(())
+                }
+                _ => Err(invalid()),
+            }),
+            _ => Err(invalid()),
+        }?;
+    }
+    let end = latest.map_or(0.0, |rel| (timecode as f64 + f64::from(rel)).max(0.0));
+    Ok(ClusterScan {
+        blocks,
+        consumed: pos,
+        end,
+    })
+}
+
+fn seek_head(b: &[u8]) -> Result<(), MediaError> {
+    children(b, |entry| {
+        if entry.id != 0x4dbb {
+            return Err(invalid());
+        }
+        let mut id = false;
+        let mut position = false;
+        children(entry.data, |field| match field.id {
+            0x53ab
+                if !id
+                    && [
+                        b"\x15\x49\xa9\x66".as_slice(),
+                        b"\x16\x54\xae\x6b",
+                        b"\x12\x54\xc3\x67",
+                        b"\x1c\x53\xbb\x6b",
+                        // Chrome's MediaRecorder indexes the first Cluster.
+                        // A seek entry is only a byte offset; the Cluster
+                        // itself is validated below.
+                        b"\x1f\x43\xb6\x75",
+                    ]
+                    .contains(&field.data) =>
+            {
+                id = true;
+                Ok(())
+            }
+            0x53ac if !position => {
+                number(field.data)?;
+                position = true;
+                Ok(())
+            }
+            _ => Err(invalid()),
+        })?;
+        if !id || !position {
+            return Err(invalid());
+        }
+        Ok(())
+    })
+}
+
+fn cues(b: &[u8]) -> Result<(), MediaError> {
+    children(b, |point| {
+        if point.id != 0xbb {
+            return Err(invalid());
+        }
+        children(point.data, |field| match field.id {
+            0xb3 => {
+                number(field.data)?;
+                Ok(())
+            }
+            0xb7 => children(field.data, |position| match position.id {
+                0xf7 if number(position.data)? == 1 => Ok(()),
+                // libwebm (WebKit) adds CueBlockNumber when the cue is not
+                // on the Cluster's first block.
+                0xf1 | 0xf0 | 0x5378 => {
+                    number(position.data)?;
+                    Ok(())
+                }
+                _ => Err(invalid()),
+            }),
+            _ => Err(invalid()),
+        })
+    })
+}
+
+/// Matroska's default TimecodeScale: one timecode unit is 1 ms.
+const DEFAULT_TIMECODE_SCALE_NS: u64 = 1_000_000;
+
+fn float(b: &[u8]) -> Option<f64> {
+    match b.len() {
+        4 => Some(f64::from(f32::from_be_bytes(b.try_into().ok()?))),
+        8 => Some(f64::from_be_bytes(b.try_into().ok()?)),
+        _ => None,
+    }
+}
+
+pub(super) fn validate_webm(b: &[u8]) -> Result<f64, MediaError> {
+    let mut pos = 0;
+    let header = next(b, &mut pos)?;
+    if header.id != 0x1a45dfa3 || header.unknown {
+        return Err(invalid());
+    }
+    let mut doc = false;
+    children(header.data, |el| match el.id {
+        0x4282 if el.data == b"webm" && !doc => {
+            doc = true;
+            Ok(())
+        }
+        0x4286 | 0x42f7 | 0x42f2 | 0x42f3 | 0x4287 | 0x4285 => {
+            number(el.data)?;
+            Ok(())
+        }
+        _ => Err(invalid()),
+    })?;
+    if !doc {
+        return Err(invalid());
+    }
+    let segment = next(b, &mut pos)?;
+    if segment.id != 0x18538067 || pos != b.len() {
+        return Err(invalid());
+    }
+    let mut found_info = false;
+    let mut found_tracks = false;
+    let mut blocks = 0;
+    let mut timecode_scale = DEFAULT_TIMECODE_SCALE_NS;
+    // Segment length in timecode units: the later of the declared Info
+    // Duration (what players show) and the last block's start (what plays).
+    let mut end = 0.0f64;
+    let mut cursor = 0;
+    while cursor < segment.data.len() {
+        let start = cursor;
+        let el = next(segment.data, &mut cursor)?;
+        if el.unknown && el.id != 0x1f43b675 {
+            return Err(invalid());
+        }
+        match el.id {
+            0x114d9b74 => seek_head(el.data),
+            0xec if el.data.iter().all(|c| *c == 0) && el.data.len() <= 4096 => Ok(()),
+            0x1549a966 if !found_info => {
+                found_info = true;
+                children(el.data, |field| match field.id {
+                    0x2ad7b1 => {
+                        timecode_scale = number(field.data)?;
+                        Ok(())
+                    }
+                    0x4489 => {
+                        let declared = float(field.data).ok_or_else(invalid)?;
+                        // f64::max skips NaN; infinity is refused by the limit.
+                        end = end.max(declared);
+                        Ok(())
+                    }
+                    0x4d80 | 0x5741 if encoder(field.data) => Ok(()),
+                    _ => Err(MediaError::MetadataForbidden),
+                })
+            }
+            0x1654ae6b if !found_tracks => {
+                found_tracks = true;
+                tracks(el.data)
+            }
+            0x1254c367 => tags(el.data),
+            0x1f43b675 if found_tracks => {
+                let scan = cluster(el.data, el.unknown)?;
+                blocks += scan.blocks;
+                end = end.max(scan.end);
+                if el.unknown {
+                    cursor = start + (segment.data[start..].len() - el.data.len()) + scan.consumed;
+                }
+                Ok(())
+            }
+            0x1c53bb6b => cues(el.data),
+            _ => Err(MediaError::MetadataForbidden),
+        }?;
+    }
+    if !found_info || !found_tracks || blocks == 0 {
+        return Err(invalid());
+    }
+    Ok(end * timecode_scale as f64 / 1e9)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn duration_tag_rejects_location_disguised_as_time() {
+        let mut data = b"\x45\xa3\x88DURATION\x44\x87\x86".to_vec();
+        data.extend_from_slice(b"40:105");
+        assert!(tag(&data).is_err());
+    }
+}

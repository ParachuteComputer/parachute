+        let cfg = test_config();
+        for secs in [35 * 60 + 5, 3 * 3600] {
+            assert_eq!(
+                validate_file_content(&ogg_ending_at(secs), &cfg).unwrap().0,
+                "audio/ogg"
+            );
+        }
+        // The fixture's first Cluster holds about a second of blocks after
+        // its start, so start it that much before the end being tested.
+        for secs in [35 * 60 + 5, 3 * 3600 - 2] {
+            assert_eq!(
+                validate_file_content(&webm_cluster_at(secs), &cfg)
+                    .unwrap()
+                    .0,
+                "audio/webm"
+            );
+        }
+        assert_eq!(
+            validate_file_content(&webm_info_duration(2105.0), &cfg)
+                .unwrap()
+                .0,
+            "audio/webm"
+        );
+    }
+
+    #[test]
+    fn opus_audio_over_3_hours_is_refused() {
+        let cfg = test_config();
+        assert!(audio_too_long(validate_file_content(
+            &ogg_ending_at(3 * 3600 + 1),
+            &cfg
+        )));
+        assert!(audio_too_long(validate_file_content(
+            &webm_cluster_at(3 * 3600 + 1),
+            &cfg
+        )));
+        assert!(audio_too_long(validate_file_content(
+            &webm_info_duration(10_801.0),
+            &cfg
+        )));
+    }

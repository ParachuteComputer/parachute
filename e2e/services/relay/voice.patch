+    fn audio_too_long(result: Result<(String, String), MediaError>) -> bool {
+        matches!(
+            result,
+            Err(MediaError::DurationTooLong {
+                kind: MediaKind::Audio,
+                max_secs: 10_800
+            })
+        )
+    }

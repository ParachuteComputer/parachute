+    /// Mark the first (video) track as holding `n` samples, so the file reads
+    /// as moving pictures rather than a single still frame.
+    fn with_video_samples(mut bytes: Vec<u8>, n: u32) -> Vec<u8> {
+        let stsz = bytes.windows(4).position(|w| w == b"stsz").unwrap();
+        // version/flags(4) | sample_size(4) | sample_count(4)
+        bytes[stsz + 8..stsz + 12].copy_from_slice(&1u32.to_be_bytes());
+        bytes[stsz + 12..stsz + 16].copy_from_slice(&n.to_be_bytes());
+        bytes
+    }
+
+    /// Set the second (audio) track's mdhd duration in milliseconds.
+    fn with_audio_duration_ms(mut bytes: Vec<u8>, ms: u32) -> Vec<u8> {
+        let mdhd = bytes
+            .windows(4)
+            .enumerate()
+            .filter(|(_, w)| *w == b"mdhd")
+            .map(|(i, _)| i)
+            .nth(1)
+            .unwrap();
+        // version/flags(4) | creation(4) | modification(4) | timescale(4) | duration(4)
+        bytes[mdhd + 20..mdhd + 24].copy_from_slice(&ms.to_be_bytes());
+        bytes
+    }

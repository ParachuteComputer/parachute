+    /// Rewrite the last Ogg page's granule so the stream ends at `secs`.
+    fn ogg_ending_at(secs: u64) -> Vec<u8> {
+        let mut ogg = include_bytes!("testdata/voice_encoder.ogg").to_vec();
+        let head = ogg.windows(8).position(|w| w == b"OpusHead").unwrap();
+        let pre_skip = u64::from(u16::from_le_bytes([ogg[head + 10], ogg[head + 11]]));
+        let mut page = 0;
+        let mut last = 0;
+        while page < ogg.len() {
+            let n = ogg[page + 26] as usize;
+            let body: usize = ogg[page + 27..page + 27 + n]
+                .iter()
+                .map(|v| *v as usize)
+                .sum();
+            last = page;
+            page += 27 + n + body;
+        }
+        let end = page;
+        let granule = secs * 48_000 + pre_skip;
+        ogg[last + 6..last + 14].copy_from_slice(&granule.to_le_bytes());
+        let crc = crate::audio::ogg_crc(&ogg[last..end]);
+        ogg[last + 22..last + 26].copy_from_slice(&crc.to_le_bytes());
+        ogg
+    }

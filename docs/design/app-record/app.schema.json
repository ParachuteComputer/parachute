{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parachute.computer/schema/app-record/app.schema.json",
  "title": "An app record",
  "description": "A record tagged `parachute-app` in the person's home vault, at Parachute/Apps/<id>. `fields.app` says which applets the app shows, where they sit, what opens what, and which signals badge or notify. It grants nothing: what runs is decided by a signed approval (approval.schema.json). Beyond this schema the app checks: `id` is the last part of `path`; `start` is in a vault that is the person's own; `theme` and `frame` name records tagged parachute-theme and parachute-frame.",
  "type": "object",
  "required": [
    "path",
    "tags",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^Parachute/Apps/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "parachute-app"
      }
    },
    "body": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "required": [
        "app"
      ],
      "properties": {
        "app": {
          "$ref": "#/$defs/app"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\n\\t]+$"
    },
    "hub": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^https?://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?$",
      "description": "A hub's origin. Left out: the hub the home vault is on."
    },
    "vault": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
    },
    "appletName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "not": {
        "pattern": "[*\\n\\t]"
      },
      "description": "The applet note's path or id, as the bar names it today."
    },
    "place": {
      "description": "One applet: {hub?, vault, applet}. The same shape the bar uses today.",
      "type": "object",
      "required": [
        "vault",
        "applet"
      ],
      "additionalProperties": false,
      "properties": {
        "hub": {
          "$ref": "#/$defs/hub"
        },
        "vault": {
          "$ref": "#/$defs/vault"
        },
        "applet": {
          "$ref": "#/$defs/appletName"
        }
      }
    },
    "source": {
      "description": "Where applets come from. One applet, every applet in a vault (applet: \"*\"), or every vault on a hub (vault: \"*\", applet: \"*\", hub named). A source lists; it never runs anything.",
      "oneOf": [
        {
          "$ref": "#/$defs/place"
        },
        {
          "type": "object",
          "required": [
            "vault",
            "applet"
          ],
          "additionalProperties": false,
          "properties": {
            "hub": {
              "$ref": "#/$defs/hub"
            },
            "vault": {
              "$ref": "#/$defs/vault"
            },
            "applet": {
              "const": "*"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "hub",
            "vault",
            "applet"
          ],
          "additionalProperties": false,
          "properties": {
            "hub": {
              "$ref": "#/$defs/hub"
            },
            "vault": {
              "const": "*"
            },
            "applet": {
              "const": "*"
            }
          }
        }
      ]
    },
    "app": {
      "type": "object",
      "required": [
        "contract",
        "id",
        "name",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\\n\\t]+$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4,
          "pattern": "^\\S+$"
        },
        "note": {
          "$ref": "#/$defs/line"
        },
        "based_on": {
          "description": "Set when the person added an app someone else offers: where the copy came from. Shown; never followed by itself.",
          "type": "object",
          "required": [
            "hub",
            "vault",
            "record"
          ],
          "additionalProperties": false,
          "properties": {
            "hub": {
              "$ref": "#/$defs/hub"
            },
            "vault": {
              "$ref": "#/$defs/vault"
            },
            "record": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "updated": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/source"
          },
          "uniqueItems": true
        },
        "hide": {
          "description": "Applets a wildcard brings that this app leaves out.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/place"
          },
          "uniqueItems": true
        },
        "bar": {
          "description": "The pinned places, in order.",
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/place"
          },
          "uniqueItems": true
        },
        "start": {
          "description": "The home applet: opens on start, first on the bar. Only in a vault that is the person's own.",
          "oneOf": [
            {
              "$ref": "#/$defs/place"
            },
            {
              "type": "null"
            }
          ]
        },
        "opens": {
          "description": "The person's choice of what opens a type of note in a vault, where more than one applet can: an applet, or null for the plain vault view. Applets still declare what they can open (fields.opens on the applet); a choice naming an applet that doesn't declare the type is skipped. A choice made on a device (Always) wins there.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "type",
              "vault",
              "applet"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$"
              },
              "hub": {
                "$ref": "#/$defs/hub"
              },
              "vault": {
                "$ref": "#/$defs/vault"
              },
              "applet": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/appletName"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "services": {
          "description": "The servers this app's applets reach, as Parachute/Settings lists them today. Shown in Settings; an applet's own record still names what it reaches.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "kind": {
                "enum": [
                  "nostr-relay",
                  "http"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 300
              }
            },
            "oneOf": [
              {
                "properties": {
                  "kind": {
                    "const": "nostr-relay"
                  },
                  "url": {
                    "pattern": "^wss?://[^\\s@]+$"
                  }
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "http"
                  },
                  "url": {
                    "pattern": "^https://[^\\s@]+/$"
                  }
                }
              }
            ]
          }
        },
        "theme": {
          "description": "Path of a theme record in the home vault. Left out: Parachute/Theme.",
          "type": "string",
          "pattern": "^Parachute/(?!(?:Apps|Grants|From)(?:/|$)|Settings$)[A-Za-z0-9][A-Za-z0-9 _-]*(?:/[A-Za-z0-9][A-Za-z0-9 _-]*)*$"
        },
        "frame": {
          "description": "Path of a frame record in the home vault. Left out: Parachute/Frame if there is one, else the app's own.",
          "type": "string",
          "pattern": "^Parachute/(?!(?:Apps|Grants|From)(?:/|$)|Settings$)[A-Za-z0-9][A-Za-z0-9 _-]*(?:/[A-Za-z0-9][A-Za-z0-9 _-]*)*$"
        },
        "keep": {
          "description": "How many applets stay running while hidden. A speed choice only: drafts and view state are kept either way. A device may override it.",
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            }
          ]
        },
        "signals": {
          "description": "Something for you: which of the applets' signals badge, also notify, or stay off. Only the person's choices: the watcher each signal uses is named on the applet, where the card shows it and the grant covers it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "enum": [
                "notify",
                "badge",
                "off"
              ]
            },
            "rules": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "vault",
                  "applet",
                  "show"
                ],
                "additionalProperties": false,
                "properties": {
                  "hub": {
                    "$ref": "#/$defs/hub"
                  },
                  "vault": {
                    "$ref": "#/$defs/vault"
                  },
                  "applet": {
                    "$ref": "#/$defs/appletName"
                  },
                  "signal": {
                    "$ref": "#/$defs/id"
                  },
                  "show": {
                    "enum": [
                      "notify",
                      "badge",
                      "off"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
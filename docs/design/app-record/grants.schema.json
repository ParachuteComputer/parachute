{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parachute.computer/schema/app-record/grants.schema.json",
  "title": "The grants record",
  "description": "One record, Parachute/Grants, tagged `parachute-grants`, in the person's home vault: the whole list of what they allowed, as one Nostr event signed by their everyday key and never sent to a relay. A device trusts only the event: its id, its signature, that the key is the one this device holds, and that `seq` is not lower than the last list it saw. `content` is JSON; its shape is $defs/content. Beyond this schema the app checks: each applet is listed once, and no grant ends more than a year after it was made.",
  "type": "object",
  "required": [
    "path",
    "tags",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "path": {
      "const": "Parachute/Grants"
    },
    "tags": {
      "type": "array",
      "contains": {
        "const": "parachute-grants"
      }
    },
    "body": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "required": [
        "grants"
      ],
      "properties": {
        "grants": {
          "type": "object",
          "required": [
            "event"
          ],
          "additionalProperties": false,
          "properties": {
            "event": {
              "type": "object",
              "required": [
                "id",
                "pubkey",
                "created_at",
                "kind",
                "tags",
                "content",
                "sig"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "pubkey": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "created_at": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "description": "A kind of its own, which the signer that works for applets refuses by name. 30479 in these examples.",
                  "const": 30479
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "contains": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "const": "d"
                      },
                      {
                        "const": "parachute-grants"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "content": {
                  "type": "string",
                  "maxLength": 262144
                },
                "sig": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{128}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "v",
        "seq",
        "prev",
        "grants"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "seq": {
          "description": "Goes up by one with each list. A device refuses a list lower than the last it saw.",
          "type": "integer",
          "minimum": 1
        },
        "prev": {
          "description": "The id of the list this one replaces; null for the first.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "grants": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "required": [
        "subject",
        "scope",
        "code",
        "under",
        "whose",
        "at",
        "expires",
        "face"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "hub",
            "vault",
            "record",
            "applet"
          ],
          "additionalProperties": false,
          "properties": {
            "hub": {
              "type": "string",
              "pattern": "^https?://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?$"
            },
            "vault": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
            },
            "record": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "applet": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "scope": {
          "description": "The hash of everything the applet asks: grantKey v4, made from the hub's address and the vault's name so that every device gets the same hash.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code": {
          "description": "The hash of the exact code that was allowed. The pin.",
          "type": "string",
          "pattern": "^(?:(?:tsx|jsx):)?[0-9a-f]{64}$"
        },
        "under": {
          "description": "The mode of the device that showed the card. A device in another mode asks itself.",
          "enum": [
            "sealed",
            "approved-code"
          ]
        },
        "whose": {
          "description": "What the person had said of the applet's vault on the device that showed the card. A device where they said otherwise asks itself.",
          "enum": [
            "mine",
            "trusted",
            "theirs"
          ]
        },
        "high": {
          "description": "The card had a High risk line. Never offered in a batch: each device shows its full card.",
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "expires": {
          "type": "string",
          "format": "date-time"
        },
        "face": {
          "description": "What the card said, so the next card can mark what is new.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "others": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "device": {
          "description": "A name for the device that showed the card. For the person to read; nothing checks it.",
          "type": "string",
          "maxLength": 40
        }
      }
    }
  }
}